    "A_target = np.zeros(fs.slm.shape)\n",
    "A_target[400:420,400:420] = 1\n",
    "model = SLMModel(fs,citl=True)\n",
    "A_target_norm = torch.tensor(model.fholo.ijcam_to_knmslm(A_target)/FeedbackHologram._norm(model.fholo.ijcam_to_knmslm(A_target)),dtype=torch.float32)\n",
    "A_target_norm[torch.isnan(A_target_norm)] = 0\n",
    "optimizer = torch.optim.SGD(model.parameters(), lr=10000000000)\n",
    "num_steps = 100\n",
    "for step in range(num_steps):\n",
    "    optimizer.zero_grad()\n",
    "    A_out = model()\n",
    "    loss = torch.nn.functional.mse_loss(A_out*A_out, A_target_norm*A_target_norm)\n",
    "    loss.backward()\n",
    "    optimizer.step()\n",
    "    print(f\"Step {step+1}/{num_steps}, Loss: {loss.item()*1e8}\")"
   ]
