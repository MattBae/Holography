    "def gs_algo(fs,iters, A_target):\n",
    "    phi_nf = torch.zeros(fs.slm.shape)\n",
    "    A_input = torch.tensor(fs.slm.source['amplitude']/FeedbackHologram._norm(fs.slm.source['amplitude']),dtype=torch.float32)\n",
    "    A_t = torch.tensor(A_target/FeedbackHologram._norm(A_target),dtype=torch.float32)\n",
    "    for iter in range(iters):\n",
    "        # Propagate to far field\n",
    "        F_ff = torch.fft.fftshift(torch.fft.fft2(torch.fft.fftshift(A_input*torch.exp(1j * phi_nf)),norm ='ortho'))\n",
    "        A_ff = torch.abs(F_ff)\n",
    "        phi_ff = torch.angle(F_ff)\n",
    "\n",
    "        # Propagate back to near field\n",
    "        F_nf = torch.fft.ifftshift(torch.fft.ifft2(torch.fft.ifftshift(A_t * torch.exp(1j * phi_ff)),norm ='ortho'))\n",
    "        A_nf = torch.abs(F_nf)\n",
    "        phi_nf = torch.angle(F_nf)\n",
    "        print(torch.nn.functional.mse_loss(A_ff*A_ff, A_t*A_t).item()*fs.slm.shape[0]*fs.slm.shape[1])\n",
    "    return A_ff\n",
    "\n",
    "def create_target(spot_vectors,fs,spot_intensities=None):\n",
    "    w = toolbox.convert_radius(fs.slm.get_spot_radius_kxy(),from_units='kxy',to_units='knm',hardware=fs)\n",
    "    target = np.zeros(fs.slm.shape)\n",
    "    i, j = np.meshgrid(np.arange(target_shape[0]), np.arange(target_shape[1]), indexing='ij')\n",
    "    for spot_location in spot_vectors:\n",
    "        xc, yc = toolbox.convert_vector(fs.ijcam_to_kxyslm(spot_location),from_units='kxy',to_units='knm',hardware = fs)\n",
    "        print(xc,yc)\n",
    "        target = target + g(i,j,1,w,xc, yc)\n",
    "    return target\n",
    "\n",
    "\n",
    "def gs_algo_spots(fs,iters, spot_vectors):\n",
    "    A_t = torch.tensor(create_target(spot_vectors.T,fs))\n",
    "    phi_nf = torch.zeros(fs.slm.shape)\n",
    "    A_input = torch.tensor(fs.slm.source['amplitude']/FeedbackHologram._norm(fs.slm.source['amplitude']),dtype=torch.float32)\n",
    "    for iter in range(iters):\n",
    "        # Propagate to far field\n",
    "        F_ff = torch.fft.fftshift(torch.fft.fft2(torch.fft.fftshift(A_input*torch.exp(1j * phi_nf)),norm ='ortho'))\n",
    "        A_ff = torch.abs(F_ff)\n",
    "        phi_ff = torch.angle(F_ff)\n",
    "\n",
    "        # Propagate back to near field\n",
    "        F_nf = torch.fft.ifftshift(torch.fft.ifft2(torch.fft.ifftshift(A_t * torch.exp(1j * phi_ff)),norm ='ortho'))\n",
    "        A_nf = torch.abs(F_nf)\n",
    "        phi_nf = torch.angle(F_nf)\n",
    "        print(torch.nn.functional.mse_loss(A_ff*A_ff, A_t*A_t).item()*fs.slm.shape[0]*fs.slm.shape[1])\n",
    "    return A_ff,phi_nf\n",
    "\n",
    "def wgs_algo_spots(fs,iters, spot_vectors):\n",
    "    A_t = torch.tensor(create_target(spot_vectors.T,fs))\n",
    "    phi_nf = torch.zeros(fs.slm.shape)\n",
